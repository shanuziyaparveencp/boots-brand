{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],

    // Matches how Vercel compiles functions in /api. Using "bundler" here
    // hid missing .js extensions locally that then failed the Vercel build.
    "module": "node16",
    "moduleResolution": "node16",

    "types": ["node"],
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
