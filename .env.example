# Boots Hyper Market - environment variables
#
# Copy this file to `.env` for local development and fill in the real values.
# `.env` is git-ignored; never commit real keys.
#
# In production these same variables go in:
#   Vercel Dashboard > your project > Settings > Environment Variables
#
# ---------------------------------------------------------------------------
# PUBLIC - shipped to the browser. The anon key is safe to expose: it is
# restricted by Supabase Row Level Security, which only allows reading active
# products.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Shown in the cart/checkout summary. The server recalculates the real figure,
# so this is only a display value. Keep it in step with SHIPPING_FEE below.
VITE_SHIPPING_FEE=100
VITE_FREE_SHIPPING_THRESHOLD=4999

# ---------------------------------------------------------------------------
# SERVER ONLY - used inside the Vercel serverless function (api/orders.ts).
# These are never bundled into the browser: Vite only exposes VITE_* variables.
# NEVER prefix these with VITE_.
# ---------------------------------------------------------------------------

# Supabase > Settings > API > service_role key. Bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same project URL as above, for the server side.
SUPABASE_URL=https://your-project-ref.supabase.co

# Authoritative shipping fee, in rupees. The order total is calculated from
# this value, not from anything the browser sends.
SHIPPING_FEE=100
FREE_SHIPPING_THRESHOLD=4999

# ---------------------------------------------------------------------------
# EMAIL - optional. If RESEND_API_KEY is missing the order is still created
# successfully; only the admin notification is skipped.
# ---------------------------------------------------------------------------

# https://resend.com > API Keys (free tier: 100 emails/day)
RESEND_API_KEY=
# Where new-order notifications are sent.
ADMIN_EMAIL=bootsfootwear@gmail.com
# Must be a domain verified in Resend. Until you verify one, Resend allows
# onboarding@resend.dev for testing.
FROM_EMAIL=onboarding@resend.dev
# Used for the "view in dashboard" link inside the notification email.
ADMIN_DASHBOARD_URL=https://boots-brand.vercel.app/admin/orders
